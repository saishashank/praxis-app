# Names only - never put real values in this file (BLD-040, D-019).
# Each name is read by the app, a script, the Worker or a workflow. `node scripts/ci/env-names.mjs`
# fails if a name the code reads is missing here or if any line holds a value.
# Where a secret lives (Vercel, GitHub environment, Cloudflare Worker) is in spec 10 SEC-017.

# --- App (Vercel) ---
# Auth.js session/JWT signing secret (row c1)
AUTH_SECRET=
# Bearer token that Vercel Cron sends to the GET heartbeat routes (row c1)
CRON_SECRET=
# Key used to hash personal data (email/name) after retention expiry
PII_HASH_KEY=
# Actions->Vercel signing secret (row c3): HMAC-SHA256 over body + timestamp for the signed calls from GitHub Actions (backup export, maintenance, watchdog). Separate value per environment; the production workflows store it as ACTIONS_HMAC_SECRET_PROD
ACTIONS_HMAC_SECRET=
# Worker->Vercel signing secret: HMAC for signed calls from the Cloudflare Worker (also set as a Worker secret)
WORKER_HMAC_SECRET=
# Staging only: secret for the test-identity sign-in
TEST_IDENTITY_SECRET=
# Public base URL of this deployment (also used by the Worker and by workflows to call the app)
APP_BASE_URL=
# Auth.js canonical origin: derived from APP_BASE_URL at start-up (V1-I10); set only to override it
AUTH_URL=
# Environment label: staging or production (staging never raises heartbeat incidents, never calls real data sources)
PRAXIS_ENV=
# Git commit of the deployed build, passed in by the deploy job (approved-commit check, go-live sign-off, self-check)
APP_COMMIT=
# Owner sign-in email address
OWNER_EMAIL=
# Production only: owner recovery email address
OWNER_RECOVERY_EMAIL=
# Production only: set to true to honour the recovery email (break-glass, default off)
OWNER_RECOVERY_ENABLED=
# Production only: public key used to encrypt backups (age recipient)
BACKUP_PUBLIC_KEY=
# Google OAuth client id
AUTH_GOOGLE_ID=
# Google OAuth client secret
AUTH_GOOGLE_SECRET=
# Email provider override (resend or mock); empty means choose by environment
EMAIL_PROVIDER=
# Staging only: set to 1 to let staging send real email through the provider (default: mock)
EMAIL_LIVE=
# Resend API key for outgoing email
RESEND_API_KEY=
# Read-only GitHub token (Actions status checks in the self-check)
GITHUB_READ_TOKEN=

# --- Databases (Turso) ---
# Turso main database URL
TURSO_MAIN_URL=
# Turso main database auth token
TURSO_MAIN_TOKEN=
# Turso auth database URL
TURSO_AUTH_URL=
# Turso auth database auth token
TURSO_AUTH_TOKEN=

# --- LLM providers ---
# Google AI (Gemini) API key
GOOGLE_AI_API_KEY=
# Groq API key
GROQ_API_KEY=
# OpenRouter API key
OPENROUTER_API_KEY=

# --- Cloudflare Worker (set as Worker secrets or vars) ---
# Fine-grained GitHub token the Worker uses to dispatch workflows
GITHUB_DISPATCH_TOKEN=
# Git commit of the deployed Worker (reported to the self-check)
BUILD_COMMIT=
# Contact user-agent string sent with ASX requests
ASX_USER_AGENT=
# Worker switch for live ASX fetches (empty or off means no live calls)
ASX_LIVE=

# --- GitHub Actions and scripts ---
# Private data repository (owner/name) that holds archives and backups
DATA_REPO=
# Token with write access to the data repository
DATA_REPO_TOKEN=
# Private fixtures repository (owner/name) read on staging and in CI
FIXTURES_REPO=
# Read-only token for the fixtures repository
FIXTURES_READ_TOKEN=
# Folder of checked-out recorded fixtures (set by the workflow after checkout)
PRAXIS_FIXTURES_DIR=
# Contact user-agent string for ASIC downloads
ASIC_USER_AGENT=
# Contact user-agent string for price-history backfill
BACKFILL_USER_AGENT=
# Yahoo ingest chunk size (set by the plan step of the ingest workflow)
YAHOO_CHUNK_SIZE=
# Yahoo ingest minimum gap in seconds between chunks (set by the plan step)
YAHOO_MIN_GAP_S=

# --- Deploy and restore drill (Owner-run workflows only) ---
# Vercel API token used by the deploy workflows
VERCEL_TOKEN=
# Cloudflare API token used to deploy the Worker
CLOUDFLARE_API_TOKEN=
# Cloudflare account id used to deploy the Worker
CLOUDFLARE_ACCOUNT_ID=
# Turso organisation name for the restore drill
TURSO_ORG=
# Turso group name for the restore drill
TURSO_GROUP=
# Short-lived Turso platform token for the drill (delete it after the run)
TURSO_PLATFORM_TOKEN_TEMP=
# Private age key for the real-key restore drill (delete it after the run; never on Vercel)
BACKUP_PRIVATE_KEY=
# Restore target database URL (restore workflow)
RESTORE_TARGET_URL=
# Restore target database auth token (restore workflow)
RESTORE_TARGET_TOKEN=
# Set by CI: outcome of the private fixtures checkout step (success, failure or skipped)
FIXTURES_CHECKOUT_OUTCOME=
# Set by scheduled workflows: the cron line that fired the run
SCHEDULE_CRON=
# Staging only: set to off to stop Cortex text-label production (CTX-040, shadow; labels run only when PRAXIS_ENV=staging)
PRAXIS_TEXT_LABELS=
# Rollback only (docs/runbooks/rollback-v2.md): set to 1 so migrate leaves a database ahead of this tree alone (D-703)
MIGRATE_ALLOW_NEWER=
# Runtime that owns this process: "cloud" (default) or "selfhost" (INFRA §6, the single-clock rule: acts only when worker_state.clock_owner names it)
PRAXIS_RUNTIME=
# Self-hosted clock only: 0 = the clock does nothing (maintenance switch; INFRA §6)
CLOCK_ENABLED=
# Self-hosted clock only: host directory of per-run scratch folders and job logs (default /srv/praxis/jobs; INFRA §3.3, §5.3)
JOBS_ROOT=
# Self-hosted clock only: path of the job manifest (default deploy/selfhost/jobs.json; INFRA §5.2)
JOBS_MANIFEST=
# Self-hosted clock only: port of the health endpoint (default 9100; INFRA §5.4)
CLOCK_HEALTH_PORT=
# Self-hosted clock only (INFRA §8.3): external dead-man check URL (healthchecks.io style); the clock pings it every 2 min while its tick is healthy; empty disables it
DEADMAN_PING_URL=
# Self-hosted clock only (INFRA §9): network reference in Mbit/s for the weekly idle trend (default 10)
IDLE_NET_REF_MBPS=
# Self-hosted clock only (INFRA §8.3): comma-separated paths whose disk use is checked (default JOBS_ROOT)
MONITOR_DISK_PATHS=
# Self-hosted clock only (INFRA §9): file read for network bytes (default /proc/net/dev; point at a bind-mounted host file to see host traffic)
HOST_NET_DEV_PATH=
# Self-hosted backups (INFRA §8.2): off-box bucket (S3 compatible) for backup copy 2
BACKUP_BUCKET_URL=
BACKUP_BUCKET_NAME=
BACKUP_BUCKET_KEY_ID=
BACKUP_BUCKET_SECRET=
BACKUP_BUCKET_REGION=
# Self-hosted sqld: restore and migrate target (INFRA §8.1)
SQLD_URL=
SQLD_ADMIN_URL=
SQLD_ADMIN_AUTH=
SQLD_NS_MODE=
SQLD_TOKEN=
# Self-hosted nightly Turso refresh target (INFRA §8.2 item 3); the auth pair is optional
TURSO_REFRESH_MAIN_URL=
TURSO_REFRESH_MAIN_TOKEN=
TURSO_REFRESH_AUTH_URL=
TURSO_REFRESH_AUTH_TOKEN=
# Operator only, never stored on the server: path of the age private key, passed per command (restore scripts)
BACKUP_PRIVATE_KEY_FILE=
# Self-hosted deploy only (praxis deploy, INFRA §10): host folders, defaults under /srv/praxis
PRAXIS_ROOT=
PRAXIS_COMPOSE_DIR=
PRAXIS_ENV_DIR=
PRAXIS_STATE_DIR=
PRAXIS_BACKUPS_DIR=
PRAXIS_CHECK_TMP=
PRAXIS_SCRIPTS_DIR=
# Self-hosted pre-deploy check only: optional signed-in session cookie for the smoke test of Home, Picks and Market
SMOKE_SESSION_COOKIE=
# Self-hosted: image registry used by `praxis deploy` instead of ghcr.io/saishashank (branch CI uses a local registry:2)
PRAXIS_REGISTRY=
# Self-hosted branch CI only (scripts/selfhost/ci/owner.mjs): database token of the clock_owner read
OWNER_TOKEN=
# Self-hosted branch CI only (scripts/selfhost/sqld-jwt.test.mjs): sqld address, admin address and the folder of the throwaway key pairs
SQLD_JWT_BASE=
SQLD_JWT_ADMIN=
SQLD_JWT_KEYS=
