# Names only - never put real values in this file (BLD-040, D-019).
# Auth.js session/JWT signing secret
AUTH_SECRET=
# Shared secret for cron/Worker calls into the app
CRON_SECRET=
# Key used to hash personal data (email/name) after retention expiry
PII_HASH_KEY=
# Signing secret for emailed one-click action links
ACTIONS_HMAC_SECRET=
# Staging only: secret for the test-identity sign-in
TEST_IDENTITY_SECRET=
# Public base URL of this deployment
APP_BASE_URL=
# Owner sign-in email address
OWNER_EMAIL=
# Production only: owner recovery email address
OWNER_RECOVERY_EMAIL=
# Production only: public key used to encrypt backups
BACKUP_PUBLIC_KEY=
# Google OAuth client id
AUTH_GOOGLE_ID=
# Google OAuth client secret
AUTH_GOOGLE_SECRET=
# Turso main database URL
TURSO_MAIN_URL=
# Turso main database auth token
TURSO_MAIN_TOKEN=
# Turso auth database URL
TURSO_AUTH_URL=
# Turso auth database auth token
TURSO_AUTH_TOKEN=
# Resend API key for outgoing email
RESEND_API_KEY=
# Google AI (Gemini) API key
GOOGLE_AI_API_KEY=
# Groq API key
GROQ_API_KEY=
# OpenRouter API key
OPENROUTER_API_KEY=
# Read-only GitHub token (Actions status checks)
GITHUB_READ_TOKEN=
# Shared secret for signing Worker-to-app requests
WORKER_HMAC_SECRET=
