exports[`inline SVG charts > bustBarBusted: deterministic snapshot 1`] = `"<figure class="m-0"><svg role="img" aria-label="Distance to bust: Busted. NAV A$250, bust A$300, 0% of the way from bust to seed" viewBox="0 0 200 28" width="100%" height="28"><defs><pattern id="bust-hatch" width="6" height="6" patternUnits="userSpaceOnUse"><path d="M0 6L6 0" stroke="var(--color-surface)" stroke-width="2"></path></pattern></defs><rect x="2" y="4" width="196" height="10" rx="2" fill="none" stroke="var(--color-grid)"></rect><rect x="2" y="4" width="0" height="10" rx="2" fill="var(--color-text)"></rect><rect x="2" y="4" width="0" height="10" rx="2" fill="url(#bust-hatch)"></rect><text x="2" y="26" font-size="10" fill="var(--color-text)">Busted</text></svg><div class="sr-only"><table><caption>Distance to bust</caption><thead><tr><th scope="col">Measure</th><th scope="col">Value</th></tr></thead><tbody><tr><th scope="row">State</th><td>Busted</td></tr><tr><th scope="row">NAV</th><td>A$250</td></tr><tr><th scope="row">Bust level</th><td>A$300</td></tr></tbody></table></div></figure>"`;

