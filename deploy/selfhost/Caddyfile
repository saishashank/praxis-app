# Public edge for Praxis (INFRA §3.1, §7). TLS is automatic (Let's Encrypt) for {$PRAXIS_DOMAIN}.
# No ACME contact address is configured (N13): Caddy obtains and renews the certificate without one. To get expiry
# notices, add a global block `{ email you@example.com }` here; an empty `email` argument is a Caddy syntax error.

{$PRAXIS_DOMAIN} {
	encode zstd gzip

	# Internal routes (clock and scripts -> web) are reached over the Docker network only
	# (http://web:3000). From the public side they do not exist.
	@internal path /api/internal /api/internal/*
	handle @internal {
		respond 404
	}

	handle {
		reverse_proxy web:3000 {
			transport http {
				dial_timeout 5s
				response_header_timeout 120s
			}
			health_uri /api/health
			health_interval 30s
			health_timeout 5s
		}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		-Server
	}

	request_body {
		max_size 10MB
	}

	log {
		output stdout
		format json
	}
}
