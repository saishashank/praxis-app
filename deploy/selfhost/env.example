# Self-hosted runtime: environment NAMES only (INFRA §2.6). No value ever goes in this file.
# Copy each section into its own file on the host, chmod 600, owner root, and fill the values from
# the Owner's password manager (never only on the VM):
#   /srv/praxis/env/web.env   /srv/praxis/env/jobs.env   /srv/praxis/env/sqld.env
# bootstrap.sh checks that every name below exists in the matching file (names only, values are never printed).
# Rules: PII_HASH_KEY and AUTH_SECRET must equal the cloud values (hashes and sessions must survive a
# switch); every other secret is a NEW value. BACKUP_PRIVATE_KEY is never on the server. The jobs
# container never gets the auth database (ROL-101a).

# ===== BEGIN web.env =====
# Runtime id: selfhost
PRAXIS_RUNTIME=
# 1 lets this runtime's clock work, 0 keeps it on standby (INFRA §6)
CLOCK_ENABLED=
# Environment label: production
PRAXIS_ENV=
# Public base URL of this runtime (https://<domain>)
APP_BASE_URL=
# Auth.js canonical origin (same as APP_BASE_URL)
AUTH_URL=
# Set to true: Auth.js is behind the Caddy proxy
AUTH_TRUST_HOST=
# Auth.js signing secret (SAME value as the cloud app)
AUTH_SECRET=
# Google OAuth client id
AUTH_GOOGLE_ID=
# Google OAuth client secret
AUTH_GOOGLE_SECRET=
# Hash key for personal data (SAME value as the cloud app)
PII_HASH_KEY=
# Main database URL (the sqld container)
TURSO_MAIN_URL=
# Main database token for sqld
TURSO_MAIN_TOKEN=
# Auth database URL (the sqld container); web only
TURSO_AUTH_URL=
# Auth database token for sqld; web only
TURSO_AUTH_TOKEN=
# Clock-to-web signing secret (shared with jobs.env, a new value)
WORKER_HMAC_SECRET=
# Jobs-to-web signing secret (shared with jobs.env, a new value)
ACTIONS_HMAC_SECRET=
# Bearer token for the cron heartbeat routes (a new value)
CRON_SECRET=
# Read-only GitHub token for the self-check
GITHUB_READ_TOKEN=
# Owner sign-in email address
OWNER_EMAIL=
# Owner recovery email address
OWNER_RECOVERY_EMAIL=
# true to honour the recovery email (default off)
OWNER_RECOVERY_ENABLED=
# Email provider override (resend or mock)
EMAIL_PROVIDER=
# 1 sends real email, 0 does not
EMAIL_LIVE=
# Resend API key
RESEND_API_KEY=
# Text labels switch used by the app
PRAXIS_TEXT_LABELS=
# ===== END web.env =====

# ===== BEGIN jobs.env =====
# Runtime id: selfhost
PRAXIS_RUNTIME=
# 1 lets the clock dispatch jobs, 0 keeps it on standby (INFRA §6)
CLOCK_ENABLED=
# Environment label: production
PRAXIS_ENV=
# Where jobs reach the app inside the Docker network: http://web:3000
APP_BASE_URL=
# Main database URL (the sqld container). Jobs never get the auth database
TURSO_MAIN_URL=
# Main database token for sqld
TURSO_MAIN_TOKEN=
# Hash key for personal data (SAME value as the cloud app)
PII_HASH_KEY=
# Clock-to-web signing secret (same value as web.env)
WORKER_HMAC_SECRET=
# Jobs-to-web signing secret (same value as web.env)
ACTIONS_HMAC_SECRET=
# Bearer token the clock sends to the cron routes /api/cron/* (same value as web.env CRON_SECRET)
CRON_SECRET=
# Fine-grained GitHub token limited to dispatching replay.yml (INF-O5)
GITHUB_DISPATCH_TOKEN=
# Private data repository (owner/name) for backup copy 1
DATA_REPO=
# Token with write access to the data repository
DATA_REPO_TOKEN=
# Public key (age recipient) that encrypts backups; the private key stays off the server
BACKUP_PUBLIC_KEY=
# Off-box backup bucket URL (backup copy 2)
BACKUP_BUCKET_URL=
# Backup bucket key id
BACKUP_BUCKET_KEY_ID=
# Backup bucket secret
BACKUP_BUCKET_SECRET=
# Bucket name
BACKUP_BUCKET_NAME=
# Bucket region
BACKUP_BUCKET_REGION=
# sqld base address used by restore and migrate commands (the sqld container)
SQLD_URL=
# sqld admin API address (namespace creation)
SQLD_ADMIN_URL=
# sqld admin API credential
SQLD_ADMIN_AUTH=
# How namespaces are addressed: subdomain or host
SQLD_NS_MODE=
# Database token for sqld restore and migrate commands
SQLD_TOKEN=
# Nightly refresh target: the cloud Turso main database (INFRA §8.2 item 3)
TURSO_REFRESH_MAIN_URL=
# Token for the Turso main refresh target
TURSO_REFRESH_MAIN_TOKEN=
# Optional: Turso auth database refresh target
TURSO_REFRESH_AUTH_URL=
# Optional: token for the Turso auth refresh target
TURSO_REFRESH_AUTH_TOKEN=
# BACKUP_PRIVATE_KEY_FILE is operator only: never stored on the server; pass it per command (praxis restore-latest).
# Owner email address (failure emails)
OWNER_EMAIL=
# Email provider override (resend or mock)
EMAIL_PROVIDER=
# 1 sends real email, 0 does not
EMAIL_LIVE=
# Resend API key
RESEND_API_KEY=
# External dead-man check URL (healthchecks.io style, INFRA §8.3); empty disables it. The service emails the Owner after 10 min of silence
DEADMAN_PING_URL=
# Optional: network reference in Mbit/s for the weekly idle trend (default 10; INFRA §9)
IDLE_NET_REF_MBPS=
# Google AI (Gemini) API key
GOOGLE_AI_API_KEY=
# Groq API key
GROQ_API_KEY=
# OpenRouter API key
OPENROUTER_API_KEY=
# Contact user-agent string sent with ASX requests
ASX_USER_AGENT=
# 1 allows live ASX fetches
ASX_LIVE=
# Text labels switch used by the app
PRAXIS_TEXT_LABELS=
# ===== END jobs.env =====

# ===== BEGIN sqld.env =====
# JWT public key (base64) that sqld uses to verify the database tokens
SQLD_AUTH_JWT_KEY=
# Key of the sqld admin API (namespace create and drop). bootstrap.sh generates it when absent; jobs.env SQLD_ADMIN_AUTH is "Basic <this key>"
SQLD_ADMIN_AUTH_KEY=
# ===== END sqld.env =====
