{
  "name": "praxis-sentinel",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["* * * * *"] },
  // D-167: ASX_LIVE and ASX_USER_AGENT are set in the Cloudflare dashboard; deploys keep them.
  "keep_vars": true,
  "vars": { "PRAXIS_ENV": "production", "APP_BASE_URL": "https://praxis-app-ssbn.vercel.app" },
  "env": {
    "staging": {
      "name": "praxis-sentinel-staging",
      "workers_dev": false,
      "preview_urls": false,
      // NFR-040: the staging cron runs only during test windows (none yet).
      "triggers": { "crons": [] },
      "vars": { "PRAXIS_ENV": "staging", "APP_BASE_URL": "https://praxis-app-staging.vercel.app" },
    },
  },
}
