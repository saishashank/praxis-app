{
  "name": "praxis-app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "db:migrate": "node scripts/db/migrate.mjs",
    "prebuild": "node scripts/gen-notices.mjs",
    "build": "node scripts/db/migrate.mjs --if-vercel && next build",
    "start": "next start",
    "build:e2e": "next build",
    "start:e2e": "next start -p 3100 -H 127.0.0.1",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:coverage:worker": "vitest run --root worker --coverage",
    "test:diffcov": "node scripts/ci/diff-coverage.mjs --lcov coverage/lcov.info --base origin/main",
    "test:smoke": "node --test \"scripts/smoke/*.test.mjs\" \"scripts/e2e/*.test.mjs\" \"scripts/maintenance/*.test.mjs\" \"scripts/backup/*.test.mjs\" \"scripts/backfill/*.test.mjs\" \"scripts/ingest/*.test.mjs\" \"scripts/arena/*.test.mjs\" \"scripts/replay/*.test.mjs\" \"scripts/restore/*.test.mjs\" \"scripts/watchdog/*.test.mjs\" \"scripts/ci/*.test.mjs\"",
    "test:routes": "node scripts/ci/route-coverage.mjs",
    "test:hygiene": "node scripts/ci/repo-hygiene.mjs",
    "test:config-reference": "node scripts/ci/config-reference.mjs --check",
    "test:env-names": "node scripts/ci/env-names.mjs",
    "test:map": "node scripts/ci/test-map.mjs --summary",
    "test:map:update": "node scripts/ci/test-map.mjs --update",
    "test:quarantine": "node scripts/ci/quarantine-check.mjs",
    "test:licences": "node scripts/ci/licence-check.mjs",
    "test:bundle": "node scripts/ci/bundle-budget.mjs",
    "test:lighthouse": "node scripts/ci/lighthouse.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "lint:workflows": "node scripts/ci/workflow-lint.mjs",
    "release-gate": "node scripts/ci/release-gate.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-popover": "1.3.1",
    "age-encryption": "0.3.1",
    "lightweight-charts": "5.2.1",
    "next": "16.4.0",
    "next-auth": "5.0.0-beta.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@stryker-mutator/core": "10.0.0",
    "@stryker-mutator/vitest-runner": "10.0.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "js-yaml": "4.3.2",
    "jsdom": "30.1.2",
    "lighthouse": "13.5.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
